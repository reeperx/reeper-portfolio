# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git and must never be committed.

# Public production origin. Used for canonical URLs, sitemap, robots,
# Open Graph/Twitter metadata, and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Public email shown in the contact panel, footer links, and structured data.
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com

# Optional search-console verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# The inbox that should receive contact-form inquiries.
CONTACT_TO_EMAIL=you@gmail.com

# The verified sender. The domain must be verified in Resend.
# For local testing, onboarding@resend.dev can only deliver to the
# address that owns the Resend account.
RESEND_FROM_EMAIL="TOGB <hello@yourdomain.com>"

# Neon Postgres connection string. The pooled connection is recommended for
# Vercel. Apply the schema with: psql "$DATABASE_URL" -f db/schema.sql
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Admin login for /admin. Use a long, unique password.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Signs the admin session cookie. Generate with:
# openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-64-hex-characters

# Salt for hashed IP addresses, user agents, and visitor IDs. Generate with:
# openssl rand -hex 32
IP_HASH_SALT=replace-with-64-hex-characters
