# Auto-blog pipeline environment variables
# Copy to .env.local and fill in real values

# Firecrawl API key for web research
# Get one at https://firecrawl.dev
FIRECRAWL_API_KEY=fc-xxxxxxxxx

# LLM API key (OpenAI-compatible)
# For Nemotron 3 via NVIDIA: get at https://build.nvidia.com
# For local Ollama: use any string (e.g., "ollama")
# For OpenAI: get at https://platform.openai.com/api-keys
LLM_API_KEY=your-llm-api-key

# LLM model name (default: nemotron-3-ultra)
# For NVIDIA Nemotron: nemotron-3-ultra
# For Ollama: llama3.1, codellama, etc.
# For OpenAI: gpt-4o-mini, gpt-4o, etc.
LLM_MODEL=nemotron-3-ultra

# Optional: Custom OpenAI-compatible base URL
# For NVIDIA Nemotron: https://integrate.api.nvidia.com/v1
# For local Ollama: http://localhost:11434/v1
# For OpenAI: (leave empty for default)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Neon Postgres connection string (pooled)
# Same as DATABASE_URL in main .env.local
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional: Number of posts to generate per run (default: 2)
POSTS_PER_RUN=2

# Optional: Minimum relevance score for research results (default: 5)
MIN_RELEVANCE_SCORE=5