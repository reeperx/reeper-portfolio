# Auto-blog pipeline environment variables
# Copy to .env.local and fill in real values

# Firecrawl API key for web research
# Get one at https://firecrawl.dev
FIRECRAWL_API_KEY=fc_xxxxxxxxx

# OpenAI API key for content generation
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxx

# Neon Postgres connection string (pooled)
# Same as DATABASE_URL in main .env.local
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional: OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Number of posts to generate per run (default: 2)
POSTS_PER_RUN=2

# Optional: Minimum relevance score for research results (default: 5)
MIN_RELEVANCE_SCORE=5